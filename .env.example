# Copy to ".env.local" at the repository root (gitignored), then fill in every value.
# Scripts load ".env.local" via scripts/dev/load-repo-env.sh (stack-up, fullstack CI script).
#
# Generate strong values (examples):
#   openssl rand -hex 24
#   openssl rand -base64 32

# Postgres (docker-compose / Spring services)
LOCAL_DB_PASSWORD=

# HS256 JWT signing (must match across user, client, transaction, Lambdas, log service)
JWT_HMAC_SECRET=

# Seeded users (must match ROOT_ADMIN_PASSWORD / agent seed in run-shared-postgres)
# Minimum length: 8 characters each
E2E_ADMIN_PASSWORD=
E2E_USER_PASSWORD=
