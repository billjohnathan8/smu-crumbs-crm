#!/usr/bin/env bash
# pre-push hook — blocks direct pushes to protected branches.
#
# Install:  git config core.hooksPath .githooks
# Bypass:   ALLOW_DIRECT_PUSH=1 git push   (use sparingly!)

set -euo pipefail

PROTECTED_BRANCHES="main integration"

# Read the remote ref info from stdin (provided by git)
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  remote_branch="${remote_ref#refs/heads/}"

  for protected in $PROTECTED_BRANCHES; do
    if [ "$remote_branch" = "$protected" ]; then
      if [ "${ALLOW_DIRECT_PUSH:-0}" = "1" ]; then
        echo "[pre-push] WARNING: pushing directly to '${protected}' (override active)."
      else
        echo ""
        echo "=========================================="
        echo "  PUSH BLOCKED: direct push to '${protected}'"
        echo "=========================================="
        echo ""
        echo "Direct pushes to '${protected}' are not allowed."
        echo "Please create a feature branch and open a PR instead."
        echo ""
        echo "If you absolutely need to push directly (rare), run:"
        echo "  ALLOW_DIRECT_PUSH=1 git push"
        echo ""
        echo "See docs/ci/branch-strategy.md for the branch strategy."
        echo "=========================================="
        exit 1
      fi
    fi
  done
done

exit 0
