#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y mount-s3 shadow-utils

systemctl enable sshd

groupadd -f sftpusers

SFTP_USER="${sftp_username}"
SFTP_KEY='${sftp_ssh_public_key}'
SFTP_CHROOT="/sftp/${sftp_username}"
SFTP_UPLOAD_DIR="$${SFTP_CHROOT}/upload"

if ! id -u "${sftp_username}" >/dev/null 2>&1; then
  useradd -M -d /nonexistent -s /usr/sbin/nologin -g sftpusers "${sftp_username}"
fi

mkdir -p /etc/ssh/authorized_keys
mkdir -p "$${SFTP_CHROOT}" "$${SFTP_UPLOAD_DIR}"
chown root:root "$${SFTP_CHROOT}"
chmod 755 "$${SFTP_CHROOT}"
chown "${sftp_username}:sftpusers" "$${SFTP_UPLOAD_DIR}"
chmod 770 "$${SFTP_UPLOAD_DIR}"

printf '%s\n' "$${SFTP_KEY}" > "/etc/ssh/authorized_keys/${sftp_username}"
chmod 600 "/etc/ssh/authorized_keys/${sftp_username}"
chown root:root "/etc/ssh/authorized_keys/${sftp_username}"

# Normalize any existing SFTP subsystem directive (tabs/spaces/paths), or add one if absent.
if grep -Eq '^[[:space:]]*Subsystem[[:space:]]+sftp([[:space:]]|$)' /etc/ssh/sshd_config; then
  sed -i -E 's|^[[:space:]]*Subsystem[[:space:]]+sftp.*|Subsystem sftp internal-sftp|' /etc/ssh/sshd_config
else
  echo "Subsystem sftp internal-sftp" >> /etc/ssh/sshd_config
fi

# Keep a single canonical Subsystem sftp line to avoid sshd startup failure.
awk '
  BEGIN { seen=0 }
  /^Subsystem[[:space:]]+sftp([[:space:]]|$)/ {
    if (seen) next
    seen=1
    print "Subsystem sftp internal-sftp"
    next
  }
  { print }
' /etc/ssh/sshd_config > /etc/ssh/sshd_config.tmp
mv /etc/ssh/sshd_config.tmp /etc/ssh/sshd_config

cat >/etc/ssh/sshd_config.d/99-sftp-only.conf <<'EOFCONF'
PasswordAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/ssh/authorized_keys/%u

Match Group sftpusers
  ChrootDirectory /sftp/%u
  ForceCommand internal-sftp
  AllowTcpForwarding no
  X11Forwarding no
  PermitTunnel no
  PasswordAuthentication no
EOFCONF

BUCKET_NAME="${bucket_name}"
BUCKET_PREFIX="${bucket_prefix}"

cat >/usr/local/bin/mount-sftp-upload.sh <<'EOFMOUNT'
#!/bin/bash
set -euo pipefail
BUCKET_NAME="__BUCKET_NAME__"
BUCKET_PREFIX="__BUCKET_PREFIX__"
MOUNT_DIR="__MOUNT_DIR__"
AWS_REGION="__AWS_REGION__"

if mountpoint -q "$${MOUNT_DIR}"; then
  exit 0
fi

if [[ -n "$${BUCKET_PREFIX}" ]]; then
  mount-s3 "$${BUCKET_NAME}" "$${MOUNT_DIR}" --prefix "$${BUCKET_PREFIX}" --region "$${AWS_REGION}"
else
  mount-s3 "$${BUCKET_NAME}" "$${MOUNT_DIR}" --region "$${AWS_REGION}"
fi
EOFMOUNT

sed -i "s|__BUCKET_NAME__|$${BUCKET_NAME}|g" /usr/local/bin/mount-sftp-upload.sh
sed -i "s|__BUCKET_PREFIX__|$${BUCKET_PREFIX}|g" /usr/local/bin/mount-sftp-upload.sh
sed -i "s|__MOUNT_DIR__|$${SFTP_UPLOAD_DIR}|g" /usr/local/bin/mount-sftp-upload.sh
sed -i "s|__AWS_REGION__|${aws_region}|g" /usr/local/bin/mount-sftp-upload.sh
chmod 755 /usr/local/bin/mount-sftp-upload.sh

cat >/etc/systemd/system/sftp-upload-mount.service <<'EOFSVC'
[Unit]
Description=Mount S3 upload prefix for SFTP user
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mount-sftp-upload.sh
ExecStop=/bin/sh -c '/usr/bin/fusermount -u /sftp/${sftp_username}/upload || /usr/bin/fusermount3 -u /sftp/${sftp_username}/upload || true'

[Install]
WantedBy=multi-user.target
EOFSVC

systemctl daemon-reload
systemctl enable sftp-upload-mount.service
systemctl start sftp-upload-mount.service
systemctl restart sshd
